---
// Página principal Milkarf (migración Astro).
// Copy adaptado del sitio legacy (index.html); cálculos en la isla Svelte.
import BaseLayout from '../layouts/BaseLayout.astro';
import { MILKARF_CONFIG, PRICES_POLLO, PRICES_RES, WA_NUMBER } from '../data/catalog';
import { getWhatsAppTemplate } from '../domain/whatsapp';
import PlanificadorMilkarf from '../components/planner/PlanificadorMilkarf.svelte';

const pollo = MILKARF_CONFIG.catalog.pollo;
const res = MILKARF_CONFIG.catalog.res;
const waQuick = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(getWhatsAppTemplate('quickHelp'))}`;
---

<BaseLayout>
	<!-- HERO -->
	<section id="inicio" class="scroll-mt-16">
		<div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 px-4 pb-16 pt-3 md:pt-6 lg:grid-cols-12 lg:gap-14">
			<div class="flex flex-col items-start space-y-6 lg:col-span-7">
				<div class="inline-flex items-center gap-2.5 rounded-full border border-green/40 bg-green/15 px-4 py-1.5 shadow-sm dark:border-green/30 dark:bg-green/20">
					<span class="relative flex h-2.5 w-2.5">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green opacity-75"></span>
						<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-dark"></span>
					</span>
					<span class="font-display text-xs font-black uppercase tracking-wide text-purple-dark dark:text-green">
						Alimentación fisiológica para perros
					</span>
				</div>

				<h1 class="font-display text-4xl font-black leading-[1.06] tracking-tight text-purple-dark sm:text-5xl lg:text-6xl dark:text-white">
					Alimentación real,
					<span class="relative inline-block bg-gradient-to-r from-purple via-pink to-purple-dark bg-clip-text text-transparent dark:from-green dark:via-pink dark:to-white">
						lista para servir
					</span
					>.
				</h1>

				<p class="max-w-xl text-base font-normal leading-relaxed text-gray-600 sm:text-lg dark:text-gray-300">
					Fórmulas fisiológicas elaboradas con ingredientes seleccionados para
					alimentar a tu perro de una manera práctica y responsable.
				</p>

				<div class="grid w-full grid-cols-1 gap-3 pt-1">
					<a
						href="#formulas"
						class="group flex w-full items-center gap-3 rounded-2xl bg-purple px-4 py-3 text-white shadow-lg shadow-purple/25 transition-all duration-200 hover:bg-purple-dark active:scale-[0.98]"
					>
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/15 text-green">
							🍗
						</span>
						<span class="flex-1 text-left text-sm font-bold leading-tight">
							Conoce nuestras fórmulas
						</span>
						<svg class="size-4 shrink-0 opacity-80 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
					<a
						href="#faq"
						class="group flex w-full items-center gap-3 rounded-2xl border-2 border-purple-border/80 bg-white px-4 py-3 text-purple-dark shadow-sm transition-all duration-200 hover:border-purple/40 active:scale-[0.98] dark:border-purple/30 dark:bg-darkcard dark:text-white"
					>
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-pink/10 text-pink">
							📖
						</span>
						<span class="flex-1 text-left text-sm font-bold leading-tight">
							Cómo empezar
						</span>
						<svg class="size-4 shrink-0 opacity-80 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				</div>

				<div class="grid w-full grid-cols-3 gap-2 border-t border-purple-border/30 pt-4 text-xs font-semibold text-purple-dark sm:gap-4 dark:border-purple/20 dark:text-purple-light/90">
					<div class="flex items-center gap-2">
						<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-green/20 text-green-dark">✓</span>
						<span class="leading-tight">
							<span class="block font-bold text-purple-dark dark:text-white">Ingredientes reales</span>
							<span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400">Sin ultraprocesados</span>
						</span>
					</div>
					<div class="flex items-center gap-2">
						<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-pink/20 text-pink-dark">❄</span>
						<span class="leading-tight">
							<span class="block font-bold text-purple-dark dark:text-white">Congelado</span>
							<span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400">Listo para descongelar</span>
						</span>
					</div>
					<div class="flex items-center gap-2">
						<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-purple/15 text-purple dark:text-purple-light">🚚</span>
						<span class="leading-tight">
							<span class="block font-bold text-purple-dark dark:text-white">Entrega directa</span>
							<span class="block text-[10px] font-normal text-gray-500 dark:text-gray-400">A tu puerta</span>
						</span>
					</div>
				</div>
			</div>

			<!-- Tarjeta visual -->
			<div class="relative flex w-full justify-center lg:col-span-5">
				<div class="pointer-events-none absolute -inset-2 -z-10 rounded-[2.5rem] bg-gradient-to-tr from-purple/30 via-pink/25 to-green/35 opacity-75 blur-2xl sm:-inset-4"></div>
				<a
					href="#formulas"
					aria-label="Ver fórmulas para perros: pollo con zanahoria y carne de res con calabacín, desde $2.50"
					class="relative block w-full max-w-md rounded-[2.2rem] border-2 border-white bg-white p-3 text-left shadow-2xl shadow-purple/15 group dark:border-purple/30 dark:bg-darkcard"
				>
					<span class="absolute -right-2 -top-3.5 z-30 flex rotate-3 items-center gap-1.5 rounded-full border-2 border-white bg-green px-3 py-1.5 text-[11px] font-black text-purple-dark shadow-lg transition-transform group-hover:rotate-0 dark:border-darkcard">
						✓ <span>Listo para servir</span>
					</span>
					<span class="relative block aspect-[4/3] overflow-hidden rounded-[1.8rem] bg-purple-light sm:aspect-square dark:bg-purple/10">
						<img
							decoding="async"
							src="https://i.ibb.co/hJP9yxd7/Gemini-Generated-Image-p554u5p554u5p554.jpg"
							onerror="this.onerror=null; this.src='images/Gemini_Generated_Image_18qpp218qpp218qp.webp'"
							alt="Alimentación fisiológica Milkarf para perros"
							class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
							loading="lazy"
						/>
						<span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0d0718]/70 via-transparent to-transparent"></span>
						<span class="absolute left-3.5 top-3.5 z-20 inline-flex items-center gap-1.5 rounded-full border border-purple-border/40 bg-white/95 px-3.5 py-1.5 font-display text-xs font-black text-purple-dark shadow-sm backdrop-blur-md dark:border-purple/30 dark:bg-darkcard/95 dark:text-white">
							<span class="size-2 animate-pulse rounded-full bg-green"></span>
							Alimentación fisiológica
						</span>
						<span class="absolute inset-x-3 bottom-3 z-20 block rounded-2xl border border-white/60 bg-white/95 px-4 py-3 text-left shadow-lg backdrop-blur-md dark:border-purple/30 dark:bg-darkcard/95">
							<span class="flex items-center justify-between gap-3">
								<span class="min-w-0">
									<span class="mb-0.5 flex items-center gap-2">
										<span class="font-display text-sm font-black text-purple-dark dark:text-white">Fórmulas disponibles</span>
										<span class="shrink-0 rounded-full bg-pink/15 px-2 py-0.5 text-[11px] font-extrabold text-pink-dark dark:text-pink">Desde $2.50</span>
									</span>
									<span class="block text-xs font-medium leading-tight text-gray-500 dark:text-gray-400">
										Pollo con zanahoria · Carne de res con calabacín
									</span>
								</span>
								<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-purple text-white shadow-md shadow-purple/20 transition-all group-hover:bg-purple-dark">
									<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
								</span>
							</span>
						</span>
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ALIMENTACIÓN FISIOLÓGICA -->
	<section class="mx-auto max-w-6xl px-4 py-12 text-center md:py-16 sm:px-6">
		<span class="mb-1 block font-display text-xs font-bold uppercase tracking-wider text-pink">
			Nutrición con propósito
		</span>
		<h2 class="font-display text-2xl font-black tracking-tight text-purple-dark sm:text-3xl lg:text-4xl dark:text-white">
			Una alimentación pensada para su naturaleza
		</h2>
		<p class="mx-auto mt-2 max-w-xl text-xs font-normal leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300">
			La alimentación fisiológica busca responder a las necesidades nutricionales
			del perro mediante ingredientes reales, proporciones adecuadas y una
			formulación responsable.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-8 text-left md:grid-cols-3">
			<div class="space-y-3">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple/10 text-purple dark:text-purple-light">🧡</div>
				<div>
					<h3 class="mb-1 text-base font-bold text-purple-dark dark:text-white">Ingredientes reales</h3>
					<p class="text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
						Carne magra, vísceras seleccionadas y vegetales frescos. Sin
						subproductos, harinas de relleno ni conservantes artificiales.
					</p>
				</div>
			</div>
			<div class="space-y-3">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-pink/10 text-pink">⚖️</div>
				<div>
					<h3 class="mb-1 text-base font-bold text-purple-dark dark:text-white">Porciones según su necesidad</h3>
					<p class="text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
						Presentaciones de 250 g y 500 g diseñadas para facilitar la porción
						diaria recomendada según el peso y la etapa de tu perro.
					</p>
				</div>
			</div>
			<div class="space-y-3">
				<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green/15 text-green-dark dark:text-green">❄️</div>
				<div>
					<h3 class="mb-1 text-base font-bold text-purple-dark dark:text-white">Práctico y seguro</h3>
					<p class="text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
						Llega congelado a tu puerta. Descongela la porción del día en tu
						refrigerador y sírvela directamente en su plato sin complicaciones.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- FÓRMULAS -->
	<section id="formulas" class="scroll-mt-16 bg-white py-14 dark:bg-darkcard">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
				<div>
					<span class="mb-1 block font-display text-xs font-bold uppercase tracking-wider text-green-dark dark:text-green">
						Listas para servir
					</span>
					<h2 class="font-display text-2xl font-black tracking-tight text-purple-dark sm:text-3xl lg:text-4xl dark:text-white">
						Nuestras fórmulas para perros
					</h2>
				</div>
				<span class="font-display text-xs font-bold text-pink">
					{pollo.presentations.map((p) => p.size.replace('gr', ' g')).join(' · ')}
				</span>
			</div>

			<div class="grid grid-cols-1 gap-7 md:grid-cols-2">
				<!-- Card Pollo -->
				<article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-purple-border/40 bg-white shadow-soft-lg dark:border-purple/25 dark:bg-darkcard">
					<div>
						<div class="relative h-52 overflow-hidden bg-purple/10">
							<img
								decoding="async"
								src="https://i.ibb.co/hJP9yxd7/Gemini-Generated-Image-p554u5p554u5p554.jpg"
								onerror="this.onerror=null; this.src='images/Gemini_Generated_Image_18qpp218qpp218qp.webp'"
								alt={`Fórmula ${pollo.name}`}
								class="h-full w-full object-cover"
								loading="lazy"
							/>
							<span class="absolute right-4 top-4 rounded-full bg-pink/90 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow-sm">
								Pollo
							</span>
						</div>
						<div class="p-6">
							<div class="mb-2 flex items-baseline justify-between">
								<h3 class="font-display text-xl font-black text-purple-dark dark:text-white">{pollo.name}</h3>
								<span class="font-display text-xs font-black text-green-dark dark:text-green">Desde {PRICES_POLLO['250gr']}</span>
							</div>
							<p class="mb-4 text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
								Una fórmula de proteína animal con zanahoria, semillas, vitaminas
								y minerales. Disponible en distintas presentaciones según el
								consumo de tu perro.
							</p>
							<div class="flex flex-wrap gap-2">
								<span class="rounded-lg bg-purple-light px-2.5 py-1 text-[10px] font-semibold text-purple-dark dark:bg-purple/20 dark:text-purple-light">250g · 500g</span>
								<span class="rounded-lg bg-green/10 px-2.5 py-1 text-[10px] font-semibold text-green-dark dark:text-green">Fórmula suave</span>
							</div>
						</div>
					</div>
					<div class="px-6 pb-6">
						<a href="#calculadora" class="block rounded-xl bg-purple py-3 text-center text-xs font-bold text-white transition-all hover:bg-purple-dark active:scale-[0.98]">
							Calcular porción y plan
						</a>
					</div>
				</article>

				<!-- Card Res -->
				<article class="flex flex-col justify-between overflow-hidden rounded-2xl border border-purple-border/40 bg-white shadow-soft-lg dark:border-purple/25 dark:bg-darkcard">
					<div>
						<div class="relative h-52 overflow-hidden bg-purple/10">
							<img
								decoding="async"
								src="https://i.ibb.co/hJP9yxd7/Gemini-Generated-Image-p554u5p554u5p554.jpg"
								onerror="this.onerror=null; this.src='images/Gemini_Generated_Image_18qpp218qpp218qp.webp'"
								alt={`Fórmula ${res.name}`}
								class="h-full w-full object-cover"
								loading="lazy"
							/>
							<span class="absolute right-4 top-4 rounded-full bg-pink/90 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow-sm">
								Res
							</span>
						</div>
						<div class="p-6">
							<div class="mb-2 flex items-baseline justify-between">
								<h3 class="font-display text-xl font-black text-purple-dark dark:text-white">{res.name}</h3>
								<span class="font-display text-xs font-black text-green-dark dark:text-green">Desde {PRICES_RES['250gr']}</span>
							</div>
							<p class="mb-4 text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
								Una fórmula de proteína animal con calabacín, semillas, vitaminas
								y minerales. Disponible en distintas presentaciones según el
								consumo de tu perro.
							</p>
							<div class="flex flex-wrap gap-2">
								<span class="rounded-lg bg-purple-light px-2.5 py-1 text-[10px] font-semibold text-purple-dark dark:bg-purple/20 dark:text-purple-light">250g · 500g</span>
								<span class="rounded-lg bg-green/10 px-2.5 py-1 text-[10px] font-semibold text-green-dark dark:text-green">Fórmula completa</span>
							</div>
						</div>
					</div>
					<div class="px-6 pb-6">
						<a href="#calculadora" class="block rounded-xl bg-purple py-3 text-center text-xs font-bold text-white transition-all hover:bg-purple-dark active:scale-[0.98]">
							Calcular porción y plan
						</a>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- CÓMO FUNCIONA -->
	<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
		<div class="mb-8 text-center">
			<span class="mb-1 block font-display text-xs font-bold uppercase tracking-wider text-pink">
				En 3 pasos
			</span>
			<h2 class="font-display text-2xl font-black tracking-tight text-purple-dark sm:text-3xl dark:text-white">
				Pide tu pedido por WhatsApp
			</h2>
		</div>
		<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
			<div class="rounded-2xl border border-purple-border/40 bg-white p-6 text-left shadow-soft dark:border-purple/20 dark:bg-darkcard">
				<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple/10 font-display text-lg font-black text-purple dark:text-purple-light">1</span>
				<h3 class="mt-3 text-base font-bold text-purple-dark dark:text-white">Completa los datos de tu mascota</h3>
				<p class="mt-1 text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
					Edad, peso y tipo de actividad. La calculadora estima la ración diaria
					recomendada y la equivalencia mensual.
				</p>
			</div>
			<div class="rounded-2xl border border-purple-border/40 bg-white p-6 text-left shadow-soft dark:border-purple/20 dark:bg-darkcard">
				<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-pink/10 font-display text-lg font-black text-pink">2</span>
				<h3 class="mt-3 text-base font-bold text-purple-dark dark:text-white">Elige fórmula, presentación y plan</h3>
				<p class="mt-1 text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
					Pollo con zanahoria o carne de res con calabacín, en bolsas de 250 g o
					500 g y con descuento por plan (hasta 10 %).
				</p>
			</div>
			<div class="rounded-2xl border border-purple-border/40 bg-white p-6 text-left shadow-soft dark:border-purple/20 dark:bg-darkcard">
				<span class="flex h-11 w-11 items-center justify-center rounded-xl bg-green/15 font-display text-lg font-black text-green-dark dark:text-green">3</span>
				<h3 class="mt-3 text-base font-bold text-purple-dark dark:text-white">Confirma tu pedido por WhatsApp</h3>
				<p class="mt-1 text-xs font-normal leading-relaxed text-gray-600 dark:text-gray-300">
					Se arma tu mensaje con los planes seleccionados. Nuestro equipo
					confirma disponibilidad, costo de entrega y pago.
				</p>
			</div>
		</div>
	</section>

	<!-- CALCULADORA (isla Svelte) -->
	<section id="calculadora" class="scroll-mt-16 bg-white py-14 dark:bg-darkcard">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<div class="mb-8 text-center">
				<span class="mb-1 block font-display text-xs font-bold uppercase tracking-wider text-green-dark dark:text-green">
					Calculadora nutricional
				</span>
				<h2 class="font-display text-2xl font-black tracking-tight text-purple-dark sm:text-3xl dark:text-white">
					Calcula la porción ideal para tu perro
				</h2>
				<p class="mx-auto mt-2 max-w-xl text-xs font-normal leading-relaxed text-gray-600 sm:text-sm dark:text-gray-300">
					Indica su peso y etapa de vida para obtener la ración diaria
					recomendada, la equivalencia mensual y el plan de alimentación que mejor
					se ajusta.
				</p>
			</div>
			<PlanificadorMilkarf client:load />
		</div>
	</section>

	<!-- GUÍA DE TRANSICIÓN + FAQ -->
	<section id="faq" class="scroll-mt-16 mx-auto max-w-3xl px-4 py-14 sm:px-6">
		<div class="mb-8 text-center">
			<span class="mb-1 block font-display text-xs font-bold uppercase tracking-wider text-pink">
				Cambio progresivo
			</span>
			<h2 class="font-display text-2xl font-black tracking-tight text-purple-dark sm:text-3xl dark:text-white">
				Guía de transición y dudas frecuentes
			</h2>
		</div>

		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
			<div class="rounded-xl border border-purple-border/40 bg-purple-light p-4 dark:border-purple/20 dark:bg-[#0d0718]">
				<p class="text-[10px] font-bold uppercase tracking-wider text-purple/60">Días 1–2</p>
				<p class="text-sm font-bold text-purple-dark dark:text-white">25% Milkarf / 75% alimento habitual</p>
			</div>
			<div class="rounded-xl border border-purple-border/40 bg-purple-light p-4 dark:border-purple/20 dark:bg-[#0d0718]">
				<p class="text-[10px] font-bold uppercase tracking-wider text-purple/60">Días 3–4</p>
				<p class="text-sm font-bold text-purple-dark dark:text-white">50% Milkarf / 50% alimento habitual</p>
			</div>
			<div class="rounded-xl border border-purple-border/40 bg-purple-light p-4 dark:border-purple/20 dark:bg-[#0d0718]">
				<p class="text-[10px] font-bold uppercase tracking-wider text-purple/60">Días 5–6</p>
				<p class="text-sm font-bold text-purple-dark dark:text-white">75% Milkarf / 25% alimento habitual</p>
			</div>
			<div class="rounded-xl border border-green/20 bg-green-light p-4 dark:border-green/10 dark:bg-green/10">
				<p class="text-[10px] font-bold uppercase tracking-wider text-green-dark dark:text-green">Día 7 en adelante</p>
				<p class="text-sm font-bold text-purple-dark dark:text-white">100% Milkarf, según tolerancia observada</p>
			</div>
		</div>
		<p class="mt-4 text-xs font-medium leading-relaxed text-gray-500 dark:text-gray-400">
