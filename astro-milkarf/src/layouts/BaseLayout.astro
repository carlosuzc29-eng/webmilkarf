---
// Layout base de Milkarf Astro (vinculado a src/styles/global.css con los tokens de marca).
// Navegación por anclas a #inicio #formulas #calculadora #faq #contacto.
import '../styles/global.css';
import { WA_NUMBER } from '../data/catalog';
import { getWhatsAppTemplate } from '../domain/whatsapp';

const title = 'Milkarf · Alimentación Fisiológica para Perros';
const description =
	'Milkarf – Alimentación real y fisiológica para perros, formulada con ingredientes seleccionados y lista para servir. Calculadora nutricional y pedidos por WhatsApp.';
const waQuick = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(getWhatsAppTemplate('quickHelp'))}`;
const phoneDisplay = '+58 412-1791137';

interface Props {
	title?: string;
	description?: string;
}

const { title: pageTitle = title, description: pageDescription = description } =
	Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
		/>
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>

		<link rel="icon" type="image/png" href="/faviconn.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="flex min-h-screen flex-col font-sans">
		<!-- Header sticky con navegación por anclas -->
		<header
			class="sticky top-0 z-40 border-b border-purple-border/40 bg-white/85 backdrop-blur-md dark:border-purple/20 dark:bg-darkcard/85"
		>
			<div
				class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
			>
				<a href="#inicio" class="flex items-center gap-2.5 shrink-0" aria-label="Milkarf, ir al inicio">
					<span
						class="flex h-9 w-9 items-center justify-center rounded-xl bg-purple text-lg shadow-soft dark:bg-darkbg dark:border dark:border-purple/30"
					>
						🐾
					</span>
					<span class="font-display text-lg font-black tracking-tight text-purple-dark dark:text-white">
						Milkarf
					</span>
				</a>

				<nav
					class="hidden items-center gap-1 rounded-full border border-purple-border/40 bg-purple-light/70 px-2 py-1.5 shadow-inner md:flex dark:border-purple/20 dark:bg-darkcard/70"
					aria-label="Principal"
				>
					<a href="#inicio" class="mka-nav-a">Inicio</a>
					<a href="#formulas" class="mka-nav-a">Fórmulas</a>
					<a href="#calculadora" class="mka-nav-a">Calculadora</a>
					<a href="#faq" class="mka-nav-a">Guía de Transición</a>
					<a href="#filosofia" class="mka-nav-a">Filosofía</a>
				</nav>

				<div class="flex items-center gap-2.5 shrink-0">
					<a
						href={waQuick}
						target="_blank"
						rel="noopener noreferrer"
						class="hidden items-center gap-2 rounded-full border border-green/40 bg-white/90 px-4 py-2 text-xs font-bold text-green-dark shadow-sm transition-all hover:bg-green/10 active:scale-95 sm:flex dark:border-green/30 dark:bg-darkcard/90 dark:text-green"
					>
						{phoneDisplay}
					</a>
					<a
						href="#calculadora"
						class="flex items-center gap-2 rounded-full bg-purple px-4 py-2 text-xs font-bold text-white shadow-soft transition-all hover:bg-purple-dark active:scale-95"
					>
						<span>Pedido</span>
						<span
							class="flex h-5 min-w-5 items-center justify-center rounded-full bg-green px-1.5 text-[10px] font-bold text-purple-dark"
						>
							0
						</span>
					</a>
					<button
						id="mka-menu-btn"
						type="button"
						class="mka-burger md:hidden"
						aria-label="Abrir menú"
						aria-expanded="false"
						aria-controls="mka-nav-overlay"
					>
						<span></span><span></span><span></span>
					</button>
				</div>
			</div>

			<!-- Overlay móvil -->
			<nav
				id="mka-nav-overlay"
				class="fixed inset-0 z-50 flex items-center justify-center bg-purple-dark/95 opacity-0 backdrop-blur-md transition-opacity duration-300 md:hidden"
				aria-hidden="true"
			>
				<div class="flex flex-col items-center gap-6 text-center">
					<a href="#inicio" class="mka-nav-overlay-a">Inicio</a>
					<a href="#formulas" class="mka-nav-overlay-a">Fórmulas</a>
					<a href="#calculadora" class="mka-nav-overlay-a">Calculadora</a>
					<a href="#faq" class="mka-nav-overlay-a">Guía de Transición</a>
					<a href="#filosofia" class="mka-nav-overlay-a">Filosofía</a>
					<a
						href={waQuick}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-4 rounded-full bg-green px-6 py-3 text-sm font-black text-purple-dark"
					>
						Escríbenos por WhatsApp
					</a>
				</div>
				<button
					type="button"
					class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl font-bold text-white"
					aria-label="Cerrar menú"
					id="mka-menu-close"
				>
					×
				</button>
			</nav>
		</header>

		<main class="flex-1 transition-colors duration-500">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="border-t border-purple-border/40 bg-white dark:border-purple/20 dark:bg-darkcard">
			<div
				class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 md:grid-cols-3"
			>
				<div>
					<h3 class="font-display text-lg font-black text-purple-dark dark:text-white">
						Milkarf
					</h3>
					<p class="mt-2 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
						Alimentación fisiológica para perros con ingredientes reales, lista
						para servir. Formulada con respaldo técnico y pedidos por WhatsApp.
					</p>
				</div>
				<div>
					<h4 class="text-xs font-black uppercase tracking-wider text-pink">
						Explora
					</h4>
					<ul class="mt-3 space-y-2 text-xs font-bold">
						<li><a href="#formulas" class="text-purple-dark hover:text-pink dark:text-purple-light">Fórmulas para perros</a></li>
						<li><a href="#calculadora" class="text-purple-dark hover:text-pink dark:text-purple-light">Calculadora nutricional</a></li>
						<li><a href="#faq" class="text-purple-dark hover:text-pink dark:text-purple-light">Guía de transición</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-xs font-black uppercase tracking-wider text-pink">
						Contacto
					</h4>
					<a
						href={waQuick}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-3 inline-flex items-center gap-2 rounded-xl border border-green/40 bg-green-light px-4 py-2.5 text-xs font-bold text-green-dark transition-all hover:bg-green/15 dark:border-green/30 dark:bg-green/10 dark:text-green"
					>
						{phoneDisplay}
					</a>
					<p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
						Entrega directa a tu puerta · Pedidos por WhatsApp
					</p>
				</div>
			</div>
			<div
				class="border-t border-purple-border/30 py-5 text-center text-[10px] font-medium text-gray-400 dark:border-purple/10 dark:text-gray-500"
			>
				© {new Date().getFullYear()} Milkarf · Alimentación fisiológica para perros
			</div>
		</footer>

		<script is:inline>
			(() => {
				const btn = document.getElementById('mka-menu-btn');
				const overlay = document.getElementById('mka-nav-overlay');
				const close = document.getElementById('mka-menu-close');
				const toggle = (open) => {
					overlay.classList.toggle('opacity-0', !open);
					overlay.classList.toggle('pointer-events-none', !open);
					btn.setAttribute('aria-expanded', String(open));
					overlay.setAttribute('aria-hidden', String(!open));
				};
				if (btn && overlay) {
					btn.addEventListener('click', () => toggle(true));
					close?.addEventListener('click', () => toggle(false));
					overlay.querySelectorAll('a').forEach((a) =>
						a.addEventListener('click', () => toggle(false)),
					);
				}
			})();
		</script>
	</body>
</html>